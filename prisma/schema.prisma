generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Nutricion diaria table
model daily_nutrition_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  meal_id     String    @db.Uuid
  fecha       DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  tipo_comida String    @db.VarChar(20)
  consumida   Boolean   @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  meals       meals     @relation(fields: [meal_id], references: [id], onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, fecha, tipo_comida, meal_id])
}

// Ejercicios table
model exercises {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  muscle_group_id           Int
  nombre                    String              @db.VarChar(100)
  descripcion               String
  dificultad                String              @default("Principiante") @db.VarChar(30)
  series_recomendadas       Int
  repeticiones_recomendadas String              @db.VarChar(30)
  imagen_url                String?             @db.VarChar(255)
  created_at                DateTime?           @default(now()) @db.Timestamptz(6)
  muscle_groups             muscle_groups       @relation(fields: [muscle_group_id], references: [id], onUpdate: NoAction)
  favorites                 favorites[]
  routine_exercises         routine_exercises[]
}

// Favoritos table
model favorites {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  exercise_id String?    @db.Uuid
  routine_id  String?    @db.Uuid
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  exercises   exercises? @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  routines    routines?  @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, exercise_id])
  @@unique([user_id, routine_id])
}

// hidratacion table
model hydration_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  fecha       DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  cantidad_ml Int       @default(0)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, fecha])
}

// plan de comidas table
model meal_plans {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  meal_id       String    @db.Uuid
  dia_semana    String    @db.VarChar(20)
  tipo_comida   String    @db.VarChar(20)
  hora_sugerida DateTime  @db.Time(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  meals         meals     @relation(fields: [meal_id], references: [id], onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, dia_semana, tipo_comida])
}

// comidas table
model meals {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre               String                 @db.VarChar(100)
  descripcion          String?
  calorias             Int
  proteinas            Decimal                @db.Decimal(6, 2)
  carbohidratos        Decimal                @db.Decimal(6, 2)
  grasas               Decimal                @db.Decimal(6, 2)
  imagen_url           String?                @db.VarChar(255)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  daily_nutrition_logs daily_nutrition_logs[]
  meal_plans           meal_plans[]
}

// musculos a trabajar table
model muscle_groups {
  id        Int         @id @default(autoincrement())
  nombre    String      @unique @db.VarChar(50)
  exercises exercises[]
}

// nutricion table
model nutrition_goals {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @unique @db.Uuid
  calorias_meta       Int       @default(2200)
  proteinas_meta      Decimal   @db.Decimal(6, 2)
  carbohidratos_meta  Decimal   @db.Decimal(6, 2)
  grasas_meta         Decimal   @default(70.00) @db.Decimal(6, 2)
  hidratacion_meta_ml Int       @default(2500)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Progreso de rutinas table
model progress_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  routine_id String?   @db.Uuid
  fecha      DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  completada Boolean   @default(true)
  notas      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  routines   routines? @relation(fields: [routine_id], references: [id], onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Ejercicios de rutinas table
model routine_exercises {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id   String    @db.Uuid
  exercise_id  String    @db.Uuid
  dia          String?   @db.VarChar(20)
  series       Int
  repeticiones String    @db.VarChar(30)
  orden        Int
  exercises    exercises @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  routines     routines  @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([routine_id, dia, orden])
}

// Rutinas table
model routines {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  nombre            String              @db.VarChar(100)
  descripcion       String?
  dias_por_semana   Int
  nivel             String              @default("Todos") @db.VarChar(30)
  activa            Boolean             @default(false)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  favorites         favorites[]
  progress_logs     progress_logs[]
  routine_exercises routine_exercises[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Users table
model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre               String                 @db.VarChar(100)
  email                String                 @unique @db.VarChar(150)
  password             String                 @db.VarChar(255)
  nivel_experiencia    String                 @default("Principiante") @db.VarChar(30)
  objetivo             String                 @db.VarChar(100)
  avatar_url           String?                @db.VarChar(255)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  daily_nutrition_logs daily_nutrition_logs[]
  favorites            favorites[]
  hydration_logs       hydration_logs[]
  meal_plans           meal_plans[]
  nutrition_goals      nutrition_goals?
  progress_logs        progress_logs[]
  routines             routines[]
}
